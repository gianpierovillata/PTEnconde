# =============================================================================
# .env.example — plantilla de variables de entorno
#
# Uso: copiar a `.env` y completar con los valores reales.
#     cp .env.example .env
#
# El archivo `.env` NUNCA se commitea (ver `.gitignore`).
# Los valores de este archivo son FALSOS, solo sirven de referencia.
# =============================================================================

# --- Proyecto / Docker Compose ---
COMPOSE_PROJECT_NAME=enconde-inbox

# --- Telegram (bot creado con BotFather) ---
TELEGRAM_BOT_TOKEN=123456789:AAExampleFakeTokenReplaceMe0000000000000
# Secreto para validar el header X-Telegram-Bot-Api-Secret-Token del webhook.
TELEGRAM_WEBHOOK_SECRET=change-me-fake-webhook-secret
TELEGRAM_API_BASE_URL=https://api.telegram.org

# --- ngrok (exposición pública: API y Angular) ---
# Cada túnel tiene su propia cuenta de ngrok y por lo tanto su authtoken.
# Los authtoken de este archivo son FALSOS; los reales viven solo en `.env`.
# NGROK_DOMAIN_* va sin esquema ni barra final; el agente recibe --url=https://<dominio>.
NGROK_AUTHTOKEN_APP=2fakeNgrokAuthTokenForAppReplaceMe000000000
NGROK_AUTHTOKEN_API=2fakeNgrokAuthTokenForApiReplaceMe000000000
# Región de ngrok: us, eu, ap, au, sa, jp, in. (No la consume el agente v3; se mantiene como referencia.)
NGROK_REGION=us
NGROK_DOMAIN_APP=trickle-batch-mollusk.ngrok-free.dev
NGROK_DOMAIN_API=wielder-removing-dilation.ngrok-free.dev
# URL pública completa de cada túnel (sin barra final).
#   API -> la que registrará el webhook de Telegram y usará el navegador.
#   APP -> origen de la app Angular (figura en CORS_ALLOWED_ORIGINS).
PUBLIC_BASE_URL=https://wielder-removing-dilation.ngrok-free.dev
FRONTEND_PUBLIC_URL=https://trickle-batch-mollusk.ngrok-free.dev

# --- API backend (.NET 10) ---
ASPNETCORE_ENVIRONMENT=Development
API_HTTP_PORT=5088
API_HTTPS_PORT=7179
# Orígenes permitidos para CORS (separados por coma).
# Incluye la app servida por ngrok (sino el navegador la bloquea).
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://localhost:8080,https://trickle-batch-mollusk.ngrok-free.dev

# --- Frontend (Angular) ---
FRONTEND_PORT=4200
# URL que usa el navegador para llegar a la API.
# Con la app servida por ngrok hay que usar HTTPS (sino, mixed content);
# en desarrollo local se usa http://localhost:5088.
FRONTEND_API_BASE_URL=https://wielder-removing-dilation.ngrok-free.dev
# URL del hub de SignalR.
FRONTEND_SIGNALR_URL=https://wielder-removing-dilation.ngrok-free.dev/hubs/inbox

# --- SQL Server ---
SQLSERVER_HOST=sqlserver
SQLSERVER_PORT=1433
SQLSERVER_DB=EncodeInbox
SQLSERVER_USER=sa
# Password de SA: mínimo 8 caracteres con mayúscula, minúscula, número y símbolo.
SQLSERVER_SA_PASSWORD=Encode1234$!
# Cadena de conexión completa usada por la API.
SQLSERVER_CONNECTION_STRING=Server=sqlserver,1433;Database=EncodeInbox;User Id=sa;Password=Encode1234$!;TrustServerCertificate=True

# --- RabbitMQ ---
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_DEFAULT_USER=inbox_user
RABBITMQ_DEFAULT_PASS=change-me-fake-rabbit-pass
RABBITMQ_VHOST=/
# Cola de mensajes entrantes de Telegram.
RABBITMQ_INCOMING_QUEUE=telegram.incoming
