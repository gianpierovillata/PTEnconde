# =============================================================================
# .env.example — plantilla de variables de entorno
#
# Uso: copiar a `.env` y completar con los valores reales.
#     cp .env.example .env
#
# El archivo `.env` NUNCA se commitea (ver `.gitignore`).
# Los valores de este archivo son FALSOS, solo sirven de referencia.
# =============================================================================

# --- Proyecto / Docker Compose ---
COMPOSE_PROJECT_NAME=enconde-inbox

# --- Telegram (bot creado con BotFather) ---
TELEGRAM_BOT_TOKEN=123456789:AAExampleFakeTokenReplaceMe0000000000000
# Secreto para validar el header X-Telegram-Bot-Api-Secret-Token del webhook.
TELEGRAM_WEBHOOK_SECRET=change-me-fake-webhook-secret
TELEGRAM_API_BASE_URL=https://api.telegram.org

# --- ngrok (exposición pública del webhook) ---
NGROK_AUTHTOKEN=2fakeNgrokAuthTokenReplaceMe000000000000000
# Región de ngrok: us, eu, ap, au, sa, jp, in.
NGROK_REGION=us
# Dominio estático de ngrok (opcional, requiere plan pago).
NGROK_DOMAIN=
# URL pública base usada por la API para registrar el webhook.
# Con ngrok en compose se resuelve en runtime; esto es un override manual.
PUBLIC_BASE_URL=https://fake-subdomain.ngrok-free.app

# --- API backend (.NET 10) ---
ASPNETCORE_ENVIRONMENT=Development
API_HTTP_PORT=5088
API_HTTPS_PORT=7179
# Orígenes permitidos para CORS (separados por coma).
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://localhost:8080

# --- Frontend (Angular) ---
FRONTEND_PORT=4200
# URL que usa el navegador para llegar a la API.
FRONTEND_API_BASE_URL=http://localhost:5088
# URL del hub de SignalR.
FRONTEND_SIGNALR_URL=http://localhost:5088/hubs/inbox

# --- SQL Server ---
SQLSERVER_HOST=sqlserver
SQLSERVER_PORT=1433
SQLSERVER_DB=EncodeInbox
SQLSERVER_USER=sa
# Password de SA: mínimo 8 caracteres con mayúscula, minúscula, número y símbolo.
SQLSERVER_SA_PASSWORD=Your_fake_Strong_Passw0rd!
# Cadena de conexión completa usada por la API.
SQLSERVER_CONNECTION_STRING=Server=sqlserver,1433;Database=EncodeInbox;User Id=sa;Password=Your_fake_Strong_Passw0rd!;TrustServerCertificate=True

# --- RabbitMQ ---
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_DEFAULT_USER=inbox_user
RABBITMQ_DEFAULT_PASS=change-me-fake-rabbit-pass
RABBITMQ_VHOST=/
# Cola de mensajes entrantes de Telegram.
RABBITMQ_INCOMING_QUEUE=telegram.incoming
